# systemd unit for the `azvpnd` system daemon.
#
# Install:
#   sudo install -m 0755 target/release/azvpnd /usr/lib/azvpn/azvpnd
#   sudo install -m 0644 packaging/systemd/azvpn.service \
#       /etc/systemd/system/azvpn.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now azvpn.service
#
# Inspect:
#   systemctl status azvpn.service
#   journalctl -u azvpn.service -f
#   ls -la /var/run/azvpn/azvpnd.sock     # expect srw-rw---- root adm
#
# Reload after a binary rebuild:
#   sudo systemctl restart azvpn.service
#
# Remove:
#   sudo systemctl disable --now azvpn.service
#   sudo rm /etc/systemd/system/azvpn.service /usr/lib/azvpn/azvpnd
#
# The daemon runs as root — it owns the openvpn child, DNS settings via
# systemd-resolved D-Bus, and route table edits. The CLI (`azvpn`)
# runs as the invoking user and talks to it over
# /var/run/azvpn/azvpnd.sock (mode 0660, group `adm` by default on
# Debian/Ubuntu — override with AZVPND_GROUP for distros that don't
# have `adm`).

[Unit]
Description=Azure VPN client daemon
Documentation=https://github.com/jlevere/azvpn
After=network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
# Type=notify — the daemon sends sd_notify(READY=1) once its socket is
# bound. Without notify systemd treats the service as "started" the
# moment fork returns, racing CLI connect attempts against socket
# bind. The daemon code path that emits READY is no-op outside Linux.
Type=notify
ExecStart=/usr/lib/azvpn/azvpnd
Restart=on-failure
RestartSec=5
# Give the daemon a window to tear down openvpn + remove routes / DNS
# state before systemd escalates to SIGKILL.
TimeoutStopSec=10s

# `AZVPND_OPENVPN` pins the openvpn binary path. Substituted at install
# time by `azvpn install-daemon` to whatever it resolved (sibling
# `azvpn-openvpn`, explicit `--openvpn <path>`, or the canonical
# `/usr/libexec/azvpn/openvpn` from the .deb / .rpm layout).
#
# **NOT `/usr/sbin/openvpn`.** Vanilla distro openvpn has
# `USER_PASS_LEN=128` unless built `--with-pkcs11` (which bumps it to
# 4096). AAD bearer tokens are 2–3 KB JWTs over `auth-user-pass`; a
# vanilla openvpn silently truncates the password and the gateway
# fails the TLS handshake opaquely. We patch our bundled openvpn
# (`patches/openvpn-increase-user-pass-len.patch`) and ship it at the
# path below.
Environment=AZVPND_OPENVPN=/usr/libexec/azvpn/openvpn
# `adm` group is the Debian/Ubuntu convention for users who can read
# system logs and similar; matches "sudoers-ish on a desktop install"
# without requiring a dedicated azvpn group. Override per-distro.
Environment=AZVPND_GROUP=adm
Environment=RUST_LOG=info

# Hardening — the openvpn child needs CAP_NET_ADMIN (manage the tun
# device, set MTU, bring it up) and we need it for the netlink route
# apply. CAP_CHOWN is needed to chown the listener socket to the
# admin group at bind time. Drop everything else.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# /dev/net/tun is the only device node we open. Everything else is
# unnecessary attack surface for a network daemon.
DeviceAllow=/dev/net/tun rw
# Daemon owns its socket dir, the cleanup-manifest dir, and (when
# the direct-file DNS backend is active) /etc/resolv.conf. The
# atomic-write helper creates the tempfile in the same directory as
# the target before rename(2), so /etc itself needs write access —
# not just /etc/resolv.conf. The hosts where the direct-file backend
# activates are the same hosts where /etc has no other writer, so
# the broader scope is operationally fine.
ReadWritePaths=/var/run/azvpn /var/lib/azvpn /etc

[Install]
WantedBy=multi-user.target
