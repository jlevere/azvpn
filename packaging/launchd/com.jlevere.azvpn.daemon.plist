<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd unit for the `azvpnd` system daemon.

  Install:
    sudo install -m 0755 target/release/azvpnd /usr/local/libexec/azvpnd
    sudo install -m 0644 packaging/launchd/com.jlevere.azvpn.daemon.plist \
        /Library/LaunchDaemons/com.jlevere.azvpn.daemon.plist
    sudo launchctl bootstrap system \
        /Library/LaunchDaemons/com.jlevere.azvpn.daemon.plist

  Inspect:
    sudo launchctl print system/com.jlevere.azvpn.daemon
    ls -la /var/run/azvpn/azvpnd.sock     # expect srw-rw---- root admin
    tail -f /var/log/azvpnd.log

  Reload after a binary rebuild:
    sudo launchctl kickstart -k system/com.jlevere.azvpn.daemon

  Remove:
    sudo launchctl bootout system/com.jlevere.azvpn.daemon

  The daemon runs as root — it owns the openvpn child, DNS settings via
  SCDynamicStore, and route table edits. The CLI (`azvpn`) runs as the
  invoking user and talks to it over /var/run/azvpn/azvpnd.sock.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jlevere.azvpn.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/azvpnd</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/azvpnd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/azvpnd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- `AZVPND_OPENVPN` pins the openvpn binary. Override this with
             the path to the *patched* openvpn 2.6.x that accepts long
             auth-user-pass lines (stock openvpn truncates the AAD
             bearer token). The flake's devshell rebuilds it from
             `patches/openvpn-increase-user-pass-len.patch`. Resolve
             once and bake the result into this plist:

               nix develop --command which openvpn

             Without an override, the daemon falls back to `openvpn` on
             $PATH — which launchd keeps minimal. -->
        <key>AZVPND_OPENVPN</key>
        <string>/usr/local/sbin/openvpn</string>
        <!-- `info` level is right for normal operation; bump to `debug`
             on the daemon to chase a bug. -->
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>

    <!-- Soft limit; tunnel pumps occasional bursts of small allocations. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>1024</integer>
    </dict>
</dict>
</plist>
